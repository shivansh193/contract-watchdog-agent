# Which model provider the agent uses. One of: gemini | bedrock | ollama
MODEL_PROVIDER=gemini

# --- gemini (default: free tier, no card required) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.6-flash

# --- bedrock (optional: pay-per-token, needs AWS credentials configured) ---
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# --- ollama (optional: fully local, free, needs `ollama serve` running) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ID=llama3

# How many days out counts as "renewal is coming up" for scan_for_renewals
RENEWAL_LOOKAHEAD_DAYS=45

# Minimum price increase (%) before detect_price_changes flags a contract
PRICE_INCREASE_THRESHOLD_PCT=8

# --- trust / autonomy controls ---
# How many days a "flagged and notified" decision stays valid before the
# agent re-evaluates that contract from scratch (see tools/memory.py)
DECISION_COOLDOWN_DAYS=7

# Contracts with no price, or priced under this $/mo, only get notified for
# high-confidence risk. 0 = no minimum, judge every contract on risk alone.
MIN_FLAG_VALUE_USD=0

# --- optional: real email sending (opt-in, NOT wired into the agent by
# default — see tools/email_sender.py for why and how to enable it) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
